#
# Bounded equivalence between the pipelined and folded cores.
#
# Q3.13 with 15 stages, the small configuration, because the state space scales with
# both the word width and the stage count and the 38-bit 28-stage datapath is far
# beyond a bounded solver. The two cores instantiate the same cordic_stage over the
# same shift and angle sequence at any configuration, so a proof at one configuration
# is evidence about the structure, not about the format; the claim is stated with the
# configuration attached either way.
#
# depth has to cover the folded core's latency (NumStages + 1 = 16) plus the reset
# release and one capture, so 22 gives a couple of cycles of margin and lets the
# cover for a second retired operation be reached.

[options]
mode bmc
depth 22
expect pass

[engines]
smtbmc z3

# sby copies everything in [files] into <task>/src and runs yosys from there, so
# these are bare filenames rather than the paths they have in the repo.
[script]
read -formal -sv -DSYNTHESIS cordic_stage.sv cordic_core_pipe.sv cordic_core_iter.sv \
     cordic_pre.sv cordic_post.sv cordic_unit.sv cordic_equiv_miter.sv
chparam -set DataWidth 16 -set FracBits 13 -set NumStages 15 cordic_equiv_miter
prep -top cordic_equiv_miter

[files]
../rtl/cordic_rom.svh
../rtl/cordic_defs.svh
../rtl/cordic_rom_fx.svh
../rtl/cordic_regmap.svh
../rtl/cordic_stage.sv
../rtl/cordic_core_pipe.sv
../rtl/cordic_core_iter.sv
../rtl/cordic_pre.sv
../rtl/cordic_post.sv
../rtl/cordic_unit.sv
cordic_equiv_miter.sv
